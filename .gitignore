# ── 系统文件 ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 编辑器 / IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── 本仓库的定位：纯文档仓库，不应出现任何构建产物 ──────────────────
# 服务本体代码在仓库外（<MCP 根目录>\<server>），这里只放文档。
node_modules/
dist/
build/
__pycache__/
.venv/
venv/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.log

# ── 本地私密信息：不要提交凭据/令牌 ────────────────────────────────
.env
.env.*
!.env.example
*.local.md
*.pem
*.key
secrets.*

# ── 编辑过程中的备份文件 ───────────────────────────────────────────
# 本仓库的惯例是改文件前留 .bak-*，那些不该进仓库
*.bak
*.bak-*
*.orig
*.tmp

# ── 迁移资料 / 归档 ───────────────────────────────────────────────
# 归档物（含本机路径的搜索历史等）一律不放仓库内
_archive/
*Run-History*.csv
